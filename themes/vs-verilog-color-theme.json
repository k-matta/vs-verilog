{
  "name": "VS Verilog Theme",
  "type": "dark",
  "tokenColors": [
    {
      "name": "Comment",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#6a9955",
        "fontStyle": "italic"
      }
    },
	{
		"name": "Strings",
		"scope": "string",
		"settings": {
			"foreground": "#eb9012"
		}
	},
    {
      "name": "I/O",
      "scope": "keyword.specifier.systemverilog",
      "settings": {
        "foreground": "#f65f85"
      }
    },
    {
      "name": "Logic",
      "scope": "keyword.logic.systemverilog",
      "settings": {
        "foreground": "#d48bcf"
      }
    },
    {
      "name": "Definitions",
      "scope": "keyword.define.systemverilog",
      "settings": {
        "foreground": "#5a52e3"
      }
    },
    {
      "name": "Operators",
      "scope": "keyword.operator.systemverilog",
      "settings": {
        "foreground": "#A0A0A0"
      }
    },
    {
      "name": "Keywords",
      "scope": "keyword",
      "settings": {
        "foreground": "#d74d97"
      }
    },
    {
      "name": "Integers",
      "scope": "constant.numeric.integer.systemverilog",
      "settings": {
        "foreground": "#7bc87b"
      }
    },
    {
      "name": "Binary",
      "scope": "constant.numeric.binary.systemverilog",
      "settings": {
        "foreground": "#81e381"
      }
    },
    {
      "name": "Octal",
      "scope": "constant.numeric.octal.systemverilog",
      "settings": {
        "foreground": "#81e381"
      }
    },
    {
      "name": "Decimal",
      "scope": "constant.numeric.decimal.systemverilog",
      "settings": {
        "foreground": "#81e381"
      }
    },
    {
      "name": "Hex",
      "scope": "constant.numeric.hexadecimal.systemverilog",
      "settings": {
        "foreground": "#81e381"
      }
    },
	{
      "name": "Normal variable",
      "scope": "variable.normal.systemverilog",
      "settings": {
        "foreground": "#6aadc5"
      }
    },
	// {
    //   "name": "Capital variable",
    //   "scope": "constant.other.caps.systemverilog",
    //   "settings": {
    //     "foreground": "#5187dd"
    //   }
    // },
	{
      "name": "Module Instance",
      "scope": "variable.other.member.systemverilog",
      "settings": {
        "foreground": "#6bcdee"
      }
    },
	{
      "name": "Module",
      "scope": "variable.other.module.systemverilog",
      "settings": {
        "foreground": "#7be793"
      }
    },
	{
      "name": "Module",
      "scope": "variable.parameter",
      "settings": {
        "foreground": "#2be8e1"
      }
    },
	{
      "name": "Variables",
      "scope": "variable",
      "settings": {
        "foreground": "#4bafb9"
      }
    }
  ]
}
