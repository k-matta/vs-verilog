{
  "name": "vs-verilog",
  "displayName": "VS Verilog",
  "description": "Verilog/SystemVerilog syntax highlighting for VS Code.",
  "version": "0.2.2",
  "publisher": "Karl",
  "repository": "https://github.com/k-matta/vs-verilog.git",
  "engines": {
    "vscode": "^1.135.0"
  },
  "scripts": {
    "build": "tsc"
  },
  "categories": [
    "Programming Languages",
    "Themes",
    "Snippets"
  ],
  "contributes": {
    "languages": [
      {
        "id": "systemverilog",
        "aliases": [
          "SystemVerilog",
          "systemverilog",
          "verilog",
          "Verilog"
        ],
        "extensions": [
          ".vs",
          ".v"
        ],
        "configuration": "./verilog-configuration.json"
      },
	  {
        "id": "modelsim",
        "aliases": [
          "ModelSim TCL Macro",
          "ModelSim",
          "Do"
		],
        "extensions": [
          ".do"
        ],
        "configuration": "./modelsim-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "systemverilog",
        "scopeName": "source.systemverilog",
        "path": "./syntaxes/systemverilog.tmLanguage.json"
      },
	  {
        "language": "modelsim",
        "scopeName": "source.modelsim",
        "path": "./syntaxes/modelsim.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "systemverilog",
        "path": "./snippets/snippets.json"
      }
    ],
    "commands": [
      {
        "command": "systemverilog.runFile",
        "title": "Quartus Compile",
        "icon": "$(play)"
      },
      {
        "command": "modelsim.runFile",
        "title": "ModelSim Run Simulation",
        "icon": "$(play)"
      }
    ],
    "menus": {
      "editor/title/run": [
        {
          "when": "editorLangId == systemverilog && workspaceFolderCount > 0",
          "command": "systemverilog.runFile",
          "group": "navigation"
        },
        {
          "when": "editorLangId == modelsim",
          "command": "modelsim.runFile",
          "group": "navigation"
        }

      ]
    },
    "configurationDefaults": {
      "[systemverilog]": {
        "editor.snippetSuggestions": "top"
      }
    }
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/vscode": "^1.135.0",
    "typescript": "^7.0.2"
  },
  "main": "./out/main.js",
  "activationEvents": [
    "onLanguage:systemverilog",
    "onCommand:systemverilog.runFile",
    "onLanguage:modelsim",
    "onCommand:modelsim.runFile"
  ]
}