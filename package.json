{
  "name": "vs-verilog",
  "displayName": "VS Verilog",
  "description": "Verilog/SystemVerilog syntax highlighting for VS Code.",
  "version": "0.0.6",
  "publisher": "Karl",
  "engines": {
    "vscode": "^1.135.0"
  },
  "categories": [
    "Programming Languages",
    "Themes",
    "Snippets"
  ],
  "contributes": {
    "languages": [
      {
        "id": "systemverilog",
        "aliases": [
          "SystemVerilog",
          "systemverilog",
          "verilog",
          "Verilog"
        ],
        "extensions": [
          ".vs",
          ".v"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "systemverilog",
        "scopeName": "source.systemverilog",
        "path": "./syntaxes/systemverilog.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "systemverilog",
        "path": "./snippets/snippets.json"
      }
    ]
  },
  "devDependencies": {
    "@types/vscode": "^1.140.0",
    "typescript": "^7.0.2"
  },
  "main": "./out/syntax.js"
}
