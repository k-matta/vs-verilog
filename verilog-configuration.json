{
    "comments": {
        "lineComment": "//",
        "blockComment": [ "/*", "*/" ]
    },
    "brackets": [
        ["{", "}"],
        ["[", "]"],
        ["(", ")"],
		["begin", "end"],
		["case", "endcase"],
		["module", "endmodule"]
    ],
    "autoClosingPairs": [
		["{", "}"],
        ["[", "]"],
        ["(", ")"],
        ["\"", "\""],
		["begin", "end"],
		["case", "endcase"],
		["module", "endmodule"]
    ],
    "surroundingPairs": [
        ["{", "}"],
        ["[", "]"],
        ["(", ")"],
        ["\"", "\""]
    ],
	"indentationRules": {
		"increaseIndentPattern": "^((?!\\/\\/).)*(\\{[^}\"'`]*|\\([^)\"'`]*|\\[[^\\]\"'`]*|begin|case\\s*\\(.*\\))$",
		"decreaseIndentPattern": "^((?!.*?\\/\\*).*\\*/)?\\s*([\\)\\}\\]]|end|endcase).*$"
	}
}