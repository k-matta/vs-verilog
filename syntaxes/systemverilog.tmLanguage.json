{
	"$schema": "../schema.json",
	"name": "SystemVerilog",
	"patterns": [
		{ "include": "#nested-objects" },
		{ "include": "#keywords" },
		{ "include": "#strings" },
		{ "include": "#storages" },
		{ "include": "#comments" },
		{ "include": "#constants" },
		{ "include": "#entities" },
		{ "include": "#variables" },
		{ "include": "#support" },
		{ "include": "#invalid" },
		{ "include": "#invalidadvanced-structures" }
	],
	"repository": {
		"keywords": {
			"patterns": [
				{
					"name": "keyword.control.systemverilog",
					"match": "\\b(if|while|for|return|break|continue|else|always_ff|always_comb|always|posedge|negedge|default)\\b"
				},
				{
					"name": "keyword.control.systemverilog",
					"match": "^\\`[a-z_\\-]+"
				},
				{
					"name": "keyword.specifier.systemverilog",
					"match": "\\b(input|output|inout)\\b"
				},
				{
					"name": "keyword.logic.systemverilog",
					"match": "\\b(and|or)\\b"
				},
				{
					"name": "keyword.define.systemverilog",
					"match": "\\b(logic|variable|integer|parameter|assign|enum|wire\\b)"
				},
				{
					"name": "keyword.operator.systemverilog",
					"match": "\\@|==|<=|>=|&&|\\|\\||\\+|-|;|:|=|<|>|-|!|~|&|\\||\\^"
				}
			]
		},
		"storages": {
			"patterns": [
				{
					"name": "storage.modifier.systemverilog",
					"match": "\\b(input|output)\\b"
				},
				{
					"name": "storage.type.systemverilog",
					"match": "\\b(logic|variable|integer|parameter|assign|enum\\b)"
				}
			]
		},
		"strings": {
			"name": "string.quoted.double.systemverilog",
			"begin": "\"",
			"end": "\"",
			"patterns": [
				{
					"name": "constant.character.escape.systemverilog",
					"match": "\\\\."
				}
			]
		},
		"comments": {
			"patterns": [
				{
					"name": "comment.block.systemverilog",
					"begin": "/\\*",
					"end": "\\*/"
				},
				{
					"name": "comment.line.double-slash.systemverilog",
					"match": "(//.*$)"
				}
			]
		},
		"support" : {
			"patterns": [
				{
					"name": "support.constant.systemverilog",
					"match": "((\\b|\\s)[A-Z_][A-Z0-9_\\-]+(\\[|\\b))"
				}
			]
		},
		"constants": {
			"patterns": [
				{
					"name": "constant.numeric.binary.systemverilog",
					"match": "\\b[0-9]*'b[01]+\\b"
				},
				{
					"name": "constant.numeric.octal.systemverilog",
					"match": "\\b[0-9]*'o[0-7]+\\b"
				},
				{
					"name": "constant.numeric.decimal.systemverilog",
					"match": "\\b[0-9]*'d[0-9]+\\b"
				},
				{
					"name": "constant.numeric.hexadecimal.systemverilog",
					"match": "\\b[0-9]*'h[0-9A-Fa-f]+\\b"
				},
				{
					"name": "constant.numeric.integer.systemverilog",
					"match": "(\\b[0-9]+\\b)"
				},
				{
					"name": "constant.character.escape.systemverilog",
					"match": "((\\\\[A-Za-z0-9])|(\\%[A-Za-z0-9]))"
				}
			]
		},
		"entities": {
			"patterns": [
				{
					"match": "(\\b[A-Za-z0-9_\\-]+\\s)([A-Za-z0-9_\\-]+)(\\s*\\()",
					"captures": {
						"1": {
							"name": "entity.name.function.systemverilog"
						},
						"2": {
							"name": "entity.name.systemverilog"
						}
					}
				},
				{
					"match": "module\\s+([A-Za-z0-9_\\-]+)(\\s+)?\\(",
					"captures": {
						"1": {
							"name": "support.class.systemverilog"
						}
					}

				}
			]
		},
		"variables": {
			"patterns": [
				{
					"match": "(\\.\\b[A-Za-z0-9_\\-]+\\s*)\\(\\s*(\\@|==|<=|>=|&&|\\|\\||\\+|-|;|:|=|<|>|-|!|~|&|\\||\\^)?\\s*([A-Za-z0-9_\\-]+)(\\[[0-9]*(:[0-9]*)?\\])?\\s*\\)",
					"captures": {
						"1": {
							"name": "variable.parameter.systemverilog"
						},
						"3": {
							"name": "variable.other.argument.systemverilog"
						},
						"4": {
							"name": "constant.numeric.integer.systemverilog"
						}
					}
				},
				{
					"match": "(\\b[a-zA-Z_][a-zA-Z0-9_\\-]+\\b)",
					"name": "variable.normal.systemverilog"
				},
				{
					"name": "variable.other.constant.systemverilog",
					"match": "((\\b|\\s)[A-Z_][A-Z0-9_\\-]+\\b)"
				}
			]
		}
	},
	"scopeName": "source.systemverilog"
}